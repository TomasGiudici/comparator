generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["comparator"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id               Int                @id(map: "pk_branches") @default(autoincrement())
  supermarket_id   Int
  city             String?            @db.VarChar(100)
  address          String?            @db.VarChar(255)
  active           Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  supermarkets     supermarkets       @relation(fields: [supermarket_id], references: [id], map: "fk_branches_supermarket")
  product_branches product_branches[]

  @@schema("comparator")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model price_history {
  id                BigInt           @id(map: "pk_price_history") @default(autoincrement())
  product_branch_id BigInt
  price             Decimal          @db.Decimal(12, 2)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  product_branches  product_branches @relation(fields: [product_branch_id], references: [id], onDelete: Cascade, map: "fk_price_history_product_branch")

  @@index([product_branch_id, created_at(sort: Desc)], map: "idx_price_history_product_branch_created_at")
  @@schema("comparator")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_branches {
  id            BigInt          @id(map: "pk_product_branches") @default(autoincrement())
  ean           String          @db.VarChar(13)
  branch_id     Int
  active        Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  price_history price_history[]
  branches      branches        @relation(fields: [branch_id], references: [id], map: "fk_product_branches_branch")

  @@unique([ean, branch_id], map: "uq_product_branches_ean_branch")
  @@index([ean], map: "idx_product_branches_active_ean", where: raw("(active = true)"))
  @@index([branch_id], map: "idx_product_branches_branch_id")
  @@index([ean], map: "idx_product_branches_ean")
  @@schema("comparator")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model supermarkets {
  id         Int        @id(map: "pk_supermarkets") @default(autoincrement())
  name       String     @unique(map: "uq_supermarkets_name") @db.VarChar(100)
  active     Boolean    @default(true)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  branches   branches[]

  @@schema("comparator")
}
